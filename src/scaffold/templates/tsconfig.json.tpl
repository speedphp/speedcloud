{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "useDefineForClassFields": true,
        "experimentalDecorators": false,
        "emitDecoratorMetadata": false,
        "lib": ["es2022", "esnext.decorators"]
    },
    "include": ["src/**/*.ts"]
}
